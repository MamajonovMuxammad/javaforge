generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  username       String        @unique
  passwordHash   String
  avatar         String        @default("☕️")
  role           String        @default("student")
  xp             Int           @default(0)
  streakCurrent  Int           @default(0)
  streakBest     Int           @default(0)
  lastActiveDate String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  progress       UserProgress?
  sessions       Session[]

  @@index([xp(sort: Desc), streakCurrent(sort: Desc)])
}

model UserProgress {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedDays      Int[]    @default([])
  completedTasks     Json     @default("{}")
  completedAt        Json     @default("{}")
  code               Json     @default("{}")
  achievements       Json     @default("{}")
  runsCount          Int      @default(0)
  compileErrorsCount Int      @default(0)
  checksCount        Int      @default(0)
  scannerDays        Int[]    @default([])
  updatedAt          DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}
